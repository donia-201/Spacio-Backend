// Copy to `.env` and fill in. Never commit the filled-in version.

PORT=3000
NODE_ENV=development

# Local Mongo, or a MongoDB Atlas SRV string for a deployed API.
DB_URL=mongodb://localhost:27017/Spacio

# Used to sign the auth tokens. Generate a new one per environment, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Comma separated list of browser origins allowed to call the API. Leave empty
# locally (any origin allowed); on the deployed API set it to your frontend
# domain, e.g. https://spacio.pages.dev
CLIENT_ORIGIN=

# Credentials for `npm run seed:staff`. No defaults on purpose.
SEED_ADMIN_EMAIL=admin@spacio.com
SEED_ADMIN_PASSWORD=
SEED_TECH_EMAIL=tech@spacio.com
SEED_TECH_PASSWORD=